{
  "name": "ollama-codex",
  "displayName": "Ollama Codex",
  "description": "Local AI Copilot for VSCode using Ollama models",
  "publisher": "kparth01",
  "categories": ["AI", "Other"],
  "keywords": ["ollama", "ai", "copilot", "llm", "local ai"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kparth01/agentic-ai-ollama-copilot.git"
  },
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.110.0"
  },
  "activationEvents": [
    "onChatParticipant:ollama"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "ollama",
        "name": "ollama",
        "fullName": "Ollama Assistant"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
