{
  "name": "ollama-codex",
  "displayName": "Ollama Codex",
  "description": "Local AI Copilot for VSCode using Ollama models",
  "publisher": "kparth01",
  "icon": "logo.png",
  "categories": ["AI", "Other"],
  "keywords": [
    "ollama",
    "ai",
    "copilot",
    "local llm",
    "local ai",
    "chatgpt alternative",
    "code assistant",
    "ollama-codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kparth01/agentic-ai-ollama-copilot.git"
  },
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.109.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:ollama"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "ollama",
        "name": "ollama",
        "fullName": "Ollama Assistant"
      }
    ],
    "commands": [
      {
        "command": "assistant.switchModel",
        "title": "Ollama Assistant: Switch Model",
        "category": "Assistant"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Assistant Configuration",
      "properties": {
        "assistant.model": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "Select the model to use for responses"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
